# VeriPay testnet configuration (deployed 2026-11-12)
DJANGO_DEBUG=1
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
VERIPAY_CONTRACT=veripay.steepdata3968.testnet
TUSD_CONTRACT=tusd.steepdata3968.testnet
OUTLAYER_CONTRACT=outlayer.testnet
OUTLAYER_PROJECT=steepdata3968.testnet/veripay-verify
DEMO_CARRIER_WALLET=logistics.steepdata3968.testnet

# AI provider (swap freely — no code changes needed)
#   echo          deterministic offline rules (default)
#   openai_compat NEAR AI Cloud / OpenAI / Groq / Ollama / any OpenAI-compatible
#   anthropic     Anthropic Messages API
AI_PROVIDER=echo
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash

# NEAR Intents cross-chain settlement
#   dry       simulated quotes (default, offline)
#   oneclick  real 1Click HTTP API (review docs.near-intents.org before enabling)
INTENTS_PROVIDER=dry
INTENTS_BASE_URL=https://1click.chaindefuser.com
INTENTS_API_KEY=
