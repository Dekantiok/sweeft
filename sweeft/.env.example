# SWEEFT testnet configuration
# Debug stays OFF unless explicitly enabled for local development.
# DJANGO_SECRET_KEY is REQUIRED when DJANGO_DEBUG=0 (server refuses to start without it).
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 1 when serving over HTTPS (session + CSRF cookies become Secure-only).
SESSION_COOKIE_SECURE=0
# Deploying on Render? render.yaml wires hosts, cookies and DATABASE_URL for you.
# On another host set DJANGO_ALLOWED_HOSTS, and optionally a Postgres URL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
SWEEFT_CONTRACT=sweeft-final2.testnet
OUTLAYER_CONTRACT=outlayer.testnet
OUTLAYER_PROJECT=steepdata3968.testnet/sweeft-verify
DEMO_CARRIER_WALLET=logistics.steepdata3968.testnet
# Demo Carrier payload signing keypair (ed25519, hex). Register the public
# key on-chain with set_carrier_pubkey so the TEE can verify carrier data.
DEMO_CARRIER_PRIVATE_KEY=
DEMO_CARRIER_PUBKEY=
# Separate Partner API credential for the standalone simulator loop.
DEMO_CARRIER_API_KEY=

# AI provider (swap freely — no code changes needed)
#   echo          deterministic offline rules (default)
#   openai_compat NEAR AI Cloud / OpenAI / Groq / Ollama / any OpenAI-compatible
#   anthropic     Anthropic Messages API
AI_PROVIDER=echo
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash

# AI co-pilot payments (scoped, revocable native-NEAR budget).
# Deploy an agent account (e.g. agent.<your>.testnet) and paste its key here,
# plus the NEAR budget contract that enforces allowance - spent on-chain.
# Testnet MVP only: on mainnet the agent key would live inside a TEE/KMS.
AI_AGENT_ENABLED=1
AI_AGENT_ACCOUNT=
AI_BUDGET_CONTRACT=budget.steepdata3968.testnet
AI_AGENT_PRIVATE_KEY=
AI_AGENT_MAX_PAYMENT=100000000000000000000000
AI_AGENT_GRANT=250000000000000000000000

# Verification relayer (platform-side automation for the happy path).
# The escrow contract exposes permissionless request_delivery_verification,
# settle_logistics and release_after_inspection — destinations and amounts are
# fixed by the escrow, so this key can only trigger pre-agreed, condition-gated
# transfers. Run with: python3 manage.py run_relayer
# Testnet MVP only: on mainnet the relayer key would live inside a TEE/KMS.
RELAYER_ENABLED=0
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=
RELAYER_POLL_SECONDS=5
RELAYER_VERIFICATION_DEPOSIT_YOCTO=10000000000000000000000

# Governance: Sputnik/Trezu DAO review board + treasury (governs disputes and
# receives platform fees; the escrow contract's arbiter/treasury point here).
GOVERNANCE_DAO=sweeft-board.testnet
